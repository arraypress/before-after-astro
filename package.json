{
  "name": "@arraypress/before-after-astro",
  "version": "1.0.0",
  "description": "Astro image-comparison slider — draggable handle, keyboard accessible, theme-token CSS.",
  "type": "module",
  "files": [
    "src/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./BeforeAfter.astro": "./src/BeforeAfter.astro",
    "./runtime": {
      "types": "./src/runtime.ts",
      "default": "./src/runtime.ts"
    },
    "./style.css": "./src/style.css",
    "./types": {
      "types": "./src/types.ts",
      "default": "./src/types.ts"
    },
    "./package.json": "./package.json"
  },
  "keywords": [
    "astro",
    "astro-component",
    "before-after",
    "image-comparison",
    "slider",
    "drag-to-compare",
    "twentytwenty",
    "withastro"
  ],
  "author": "ArrayPress",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arraypress/before-after-astro.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "astro": "^6.0.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "astro": "^6.3.7",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
